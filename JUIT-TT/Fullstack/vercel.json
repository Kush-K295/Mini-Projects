{
  "builds": [
    {
      "src": "main.py",
      "use": "@vercel/python"
    }
  ],
  "functions": {
    "main.py": {
      "includeFiles": "Data/**"
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/public/index.html"
    },
    {
      "source": "/(.*\\.(js|css|webm|png|ico|jpg|jpeg))",
      "destination": "/public/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/main.py"
    }
  ]
}